import pandas as pd
from scipy.stats import pearsonr
df = pd.read_csv(r'C:\Users\PC\Desktop\VTI Academy\World Cup_final_cleanded.scv')
df.info()
# Bước 1: Lọc các trận có own goal
df['og_count'] = df['away_own_goal'].str.count(r'\(OG\)')
own_goals_df = df[df['og_count'].notna() & (df['og_count'] > 0)]

# Bước 2: Nhóm theo home_team vì away_own_goal là phản lưới vào lưới đội chủ nhà
own_goal_against = own_goals_df.groupby('home_team')['away_own_goal'].sum().reset_index()
own_goal_againstw = own_goals_df.groupby('away_team')['away_own_goal'].sum().reset_index()
# Sắp xếp giảm dần để tìm đội bị phản lưới nhiều nhất
own_goal_against = own_goal_against.sort_values(by='away_own_goal', ascending=False)
own_goal_againstw = own_goal_againstw.sort_values(by='away_own_goal', ascending=False)
# In kết quả
print("Đội chủ nhà dễ được 'tặng' bàn phản lưới nhiều nhất là:")
print(own_goal_against.head())
print("Đội khách dễ được 'tặng' bàn phản lưới nhiều nhất là:")
