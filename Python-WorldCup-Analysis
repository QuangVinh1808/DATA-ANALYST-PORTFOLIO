print(f'Trận thắng của đội khách: {away_wins} ({away_win_rate:.2%})')
print(f'Trận hòa: {draws} ({draws / total_matches:.2%})')

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
#Câu 2  Tương quan giữa xG và số bàn thắng thực tế là bao nhiêu? Có hiện tượng underperformance hay overperformance không?
# Tính tổng số bàn thắng và tổng xG
df['total_goals'] = df['home_score'] + df['away_score']
df['total_xg'] = df['home_xg'] + df['away_xg']

# Tính tổng cộng
total_goals = df['total_goals'].sum()
total_xg = df['total_xg'].sum()

print(f"Tổng bàn thắng thực tế: {total_goals}")
print(f"Tổng xG: {total_xg}")
print(f"Chênh lệch (goals - xG): {total_goals - total_xg:.2f}")

# Kiểm tra overperformance / underperformance
if total_goals > total_xg:
    print("→ Có hiện tượng overperformance (hiệu suất vượt kỳ vọng).")
elif total_goals < total_xg:
    print("→ Có hiện tượng underperformance (hiệu suất thấp hơn kỳ vọng).")
else:
    print("→ Hiệu suất đúng với kỳ vọng.")

# Tính hệ số tương quan Pearson
correlation = df[['total_goals', 'total_xg']].corr().iloc[0, 1]
print(f"Hệ số tương quan Pearson giữa xG và bàn thắng: {correlation:.2f}")

#biểu đồ giữa xG và Goals
plt.figure(figsize=(8, 5))
sns.scatterplot(data=df, x='total_xg', y='total_goals')
sns.regplot(data=df, x='total_xg', y='total_goals', scatter=False, color='red')
plt.title('Tương quan giữa xG và số bàn thắng thực tế')
plt.xlabel('Expected Goals (xG)')
plt.ylabel('Thực tế Goals')
plt.grid(True)
plt.tight_layout()
plt.show()



