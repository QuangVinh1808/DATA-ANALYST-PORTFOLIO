import pandas as pd
from scipy.stats import pearsonr
import matplotlib.pyplot as plt
import seaborn as sns
df = pd.read_csv(r'C:\Users\PC\Desktop\VTI Academy\World Cup_final_cleanded.scv')

df['match_result'] = df.apply(
    lambda row: 'Home Win' if row['home_score'] > row['away_score']
    else ('Away Win' if row['home_score'] < row['away_score'] else 'Draw'),
    axis=1
)
# Xem vài dòng kết quả
print(df[['home_team', 'away_team', 'home_score', 'away_score', 'match_result']])

# Đếm số lần xuất hiện chuỗi '(P)' trong cột 'home_penalty_goal'
df['penalty_count'] = df['home_penalty_goal'].str.count(r'\(P\)')
# Hiển thị kết quả
print(df[['home_penalty_goal', 'penalty_count']])

# Đếm số lần xuất hiện chuỗi '(P)' trong cột 'away_penalty_goal'
df['penalty_count_away_team'] = df['away_penalty_goal'].str.count(r'\(P\)')
# Hiển thị kết quả
print(df[['away_penalty_goal', 'penalty_count_away_team']])
# Tỉ lệ bàn thắng đến từ Penalty của các đội
df['penalty_ratio_home_team'] = df['penalty_count']/df['home_score']
print(df['penalty_ratio_home_team'])
df['penalty_ratio_away_team'] = df['penalty_count_away_team']/df['away_score']
print(df['penalty_ratio_away_team'])
# Gộp dữ liệu để vẽ bằng seaborn
df_melt = pd.melt(
    df,
    value_vars=['penalty_ratio_home_team', 'penalty_ratio_away_team'],
    var_name='Team',
    value_name='Penalty Ratio'
)

# Chuyển nhãn dễ hiểu hơn
df_melt['Team'] = df_melt['Team'].replace({
    'penalty_ratio_home_team': 'Home Team',
    'penalty_ratio_away_team': 'Away Team'
})

# Vẽ boxplot để so sánh phân bố tỷ lệ penalty giữa hai loại đội
sns.boxplot(data=df_melt, x='Team', y='Penalty Ratio', palette='Set2')
plt.title('So sánh tỷ lệ bàn thắng từ penalty giữa đội chủ nhà và đội khách')
plt.ylabel('Tỷ lệ bàn thắng từ penalty')
plt.xlabel('Đội')

plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.show()


# Trung bình tỷ lệ penalty theo loại đội
home_avg = df['penalty_ratio_home_team'].mean()
away_avg = df['penalty_ratio_away_team'].mean()

# Vẽ cột so sánh
plt.figure(figsize=(6, 4))
plt.bar(['Home Team', 'Away Team'], [home_avg, away_avg], color=['skyblue', 'salmon'])
plt.title('Trung bình tỷ lệ bàn thắng từ penalty')
plt.ylabel('Tỷ lệ (%)')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()


