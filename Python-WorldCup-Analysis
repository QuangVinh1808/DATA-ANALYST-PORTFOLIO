import pandas as pd
from scipy.stats import pearsonr
df = pd.read_csv(r'C:\Users\PC\Desktop\VTI Academy\World Cup_final_cleanded.scv')
df.info()
#Câu 1 : Xác định kết quả trận đấu
df['result'] = df.apply(lambda row: 'Home Win' if row['home_score'] > row['away_score'] 
                        else 'Away Win' if row['home_score'] < row['away_score'] 
                        else 'Draw', axis=1)
# Tính tổng số trận
total_matches = len(df)

# Tính số trận thắng của đội chủ nhà và đội khách
home_wins = (df['result'] == 'Home Win').sum()
away_wins = (df['result'] == 'Away Win').sum()
draws = (df['result'] == 'Draw').sum()

# Tính tỷ lệ
home_win_rate = home_wins / total_matches
away_win_rate = away_wins / total_matches

